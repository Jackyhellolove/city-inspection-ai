# 仅保存在你的 Mac 本机；复制为 .env 后填写。不要把真实密钥发到聊天或提交到 GitHub。
# 可选值：openai、dashscope、compatible。切换后重启 python3 web_app.py。
AI_PROVIDER=dashscope

# 统一模型配置。dashscope 默认地址可省略；compatible 必须填写三个值。
AI_API_KEY=请在这里填写_API_密钥
AI_MODEL=qwen3-vl-plus
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OpenAI 示例：AI_PROVIDER=openai，AI_MODEL=gpt-5.6，AI_API_KEY=sk-...
# 通义千问示例：AI_PROVIDER=dashscope，AI_MODEL=qwen3-vl-plus，AI_API_KEY=sk-...
# 其他 OpenAI 兼容视觉服务示例：AI_PROVIDER=compatible，填写其 API 地址、密钥和支持图片输入的模型名。
# DeepSeek 日后若提供兼容接口的视觉模型，可使用：AI_PROVIDER=compatible，并填写 DeepSeek 的视觉模型名和 API 地址。

# 城市运行态势 AI 研判：默认复用上面的百炼 API Key，不影响照片识别模型。
SITUATION_AI_PROVIDER=dashscope
SITUATION_AI_MODEL=qwen3.7-plus
# 可选：用英文逗号分隔允许管理员在驾驶舱切换测试的模型；默认模型会自动加入名单。
SITUATION_AI_MODELS=qwen3.7-plus
# 如需单独密钥可填写；留空时自动使用 AI_API_KEY 或 DASHSCOPE_API_KEY。
# SITUATION_AI_API_KEY=请在这里填写百炼_API_Key
# 中国内地建议使用华北2（北京）DashScope 地址。
SITUATION_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Supabase 登录鉴权。取消注释后必须粘贴项目 Settings > API 中的真实值，不要保留中文占位文字。
# 本地若已有 supabase-config.js 可暂时省略；Render 发布时必须填写。
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_real_public_key

# 领导驾驶舱高德地图配置。Key 类型必须选择“Web端（JS API）”。
AMAP_WEB_KEY=请填写高德_Web_Key
AMAP_SECURITY_JS_CODE=请填写高德安全密钥
AMAP_COORDINATE_SYSTEM=WGS84
# 生产环境配置安全代理后，使用 AMAP_SERVICE_HOST，并删除 AMAP_SECURITY_JS_CODE。
# AMAP_SERVICE_HOST=https://你的域名/_AMapService
